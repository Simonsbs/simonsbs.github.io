{
  "name": "simon-stirling-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://bestdev.co.il/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/content.mjs",
    "dev": "vite --host 127.0.0.1",
    "prestart": "node scripts/content.mjs",
    "start": "vite --host 127.0.0.1",
    "build": "npm run check && vite build && node scripts/prerender.mjs && node scripts/check-build.mjs && node scripts/check-seo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "precheck": "node scripts/content.mjs",
    "check": "tsc --noEmit && node scripts/check-content.mjs && node scripts/check-projects.mjs && npm run test:analytics",
    "test:analytics": "node --experimental-strip-types --test scripts/analytics.test.mjs",
    "verify:live": "node scripts/verify-showcase-live.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b master -d dist --nojekyll --dotfiles"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
